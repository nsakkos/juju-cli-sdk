#!/bin/bash
# setup-base — wire the Juju CLI onto the system PATH.
#
# Runs as root when the SDK is first installed and on every workshop refresh;
# its effects are baked into the base snapshot. `SDK` points at the SDK
# installation root inside the workshop (the `dump` part put juju at
# "$SDK/bin/juju"). errexit + pipefail are set by Workshop.
#
# Only PATH is set — no controller, cloud, or credential defaults are baked in.
# Those are supplied by the consumer at runtime (this SDK is a client of a
# remote Juju controller, not a controller).

# System-wide env under /etc/profile.d/ so it applies across shells. $SDK is
# expanded now (bakes the real install path); \$PATH stays literal for runtime.
cat <<EOF > /etc/profile.d/juju.sh
export PATH="$SDK/bin:\$PATH"
EOF

# Emit the version for the install log. No `| head` here: `head` closing the
# pipe early sends SIGPIPE to juju, and pipefail would surface that (141) as a
# hook failure.
"$SDK/bin/juju" version
